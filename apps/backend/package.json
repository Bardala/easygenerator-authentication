{
  "name": "@easygenerator/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names compiler,api \"tsc --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-mongo": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "nest-winston": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}

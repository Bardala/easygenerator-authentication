# Copy to .env at the repository root. Never commit real secrets.
APP_ENV=local
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/easygenerator
LOG_LEVEL=info
# Trust only a known reverse proxy. Leave 0 for direct local access.
TRUST_PROXY_HOPS=0
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-generated-secret

# Container settings (generate independent secrets using the command above).
PUBLIC_ORIGIN=https://localhost:8080
MONGO_ROOT_PASSWORD=replace-with-a-generated-secret
MONGO_APP_PASSWORD=replace-with-a-different-generated-secret
FRONTEND_PORT=8080
BIND_ADDRESS=127.0.0.1
# Required only by compose.https.yaml; private key must be readable by nginx.
TLS_CERT_PATH=/absolute/path/to/cert.pem
TLS_KEY_PATH=/absolute/path/to/key.pem

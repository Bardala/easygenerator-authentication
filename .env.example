# Copy to .env at the repository root. Never commit real secrets.
APP_ENV=local
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/easygenerator
LOG_LEVEL=info
# Trust only a known reverse proxy. Leave 0 for direct local access.
TRUST_PROXY_HOPS=0
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-generated-secret
